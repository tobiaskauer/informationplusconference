# Copy to .env.preview (git-ignored) and fill in, then run: npm run deploy:preview

# SSH destination (uses your existing SSH key / ~/.ssh/config).
PREVIEW_SSH=user@example.com
# Folder on the server that is served as the preview site. Its contents are
# replaced on every deploy (rsync --delete), so use a folder dedicated to it.
PREVIEW_PATH=/var/www/infoplus-preview

# Public URL of the preview (no trailing slash).
PREVIEW_SITE=https://preview.example.com
# Only if the preview lives in a sub-folder, e.g. /infoplus-preview — otherwise leave empty.
PREVIEW_BASE=

# Optional: a specific SSH key, if ~/.ssh/config does not already select one.
PREVIEW_SSH_KEY=
