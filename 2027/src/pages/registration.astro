---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import { isExternal, resolveHref } from '../lib/url';

// `main.md` is the singleton page record edited in Tina.
const page = await getEntry('registrationPage', 'main');
const { Content } = page ? await render(page) : { Content: null };
const intro = page?.data.intro?.trim();
const ctaLabel = page?.data.cta?.label?.trim();
const ctaHref = page?.data.cta?.href?.trim();
---

<Base title="Registration" description={intro}>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Registration' }]} />
  <span class="eyebrow">Join us</span>
  <h1>Registration</h1>

  {intro && <p class="registration-intro">{intro}</p>}

  {Content && (
    <div class="prose">
      <Content />
    </div>
  )}

  {ctaLabel && ctaHref && (
    <div class="hero-actions">
      <a
        class="btn"
        href={resolveHref(ctaHref)}
        {...(isExternal(ctaHref) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
      >
        <span>{ctaLabel}</span>
        <Icon name={isExternal(ctaHref) ? 'external-link' : 'arrow-right'} />
      </a>
    </div>
  )}
</Base>

<style>
  .registration-intro {
    max-width: 700px;
    margin: 0 0 32px;
    font-family: var(--rd-35);
    font-size: clamp(22px, 18px + 0.8vw, 30px);
    line-height: 1.45;
  }
</style>
